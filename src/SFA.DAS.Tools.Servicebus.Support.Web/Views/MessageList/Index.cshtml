@model MessageListViewModel

@section Scripts
{
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-table/1.18.1/bootstrap-table.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/lodash.js/4.17.11/lodash.min.js"></script>

    <script type="text/javascript">

        function operateFormatter(value, row, index) {
            return '<a class="detail" href=' + ($('#baseUrl').val() + "/?id=" + row.id) + ' title ="Detail">Detail</a>';
        };

        var $table = $("#table");
        var selections = [];

        function responseHandler(res) {
            $.each(res.rows,
                function (i, row) {
                    row.state = $.inArray(row.id, selections) !== -1;
                });

            return res;
        }

        $(function () {
            $table.on('check.bs.table check-all.bs.table uncheck.bs.table uncheck-all.bs.table',
                function (e, rowsAfter, rowsBefore) {
                    var rows = rowsAfter;

                    if (e.type === 'uncheck-all') {
                        rows = rowsBefore;
                    }

                    var ids = $.map(!$.isArray(rows) ? [rows] : rows,
                        function (row) {
                            return row.id;
                        });

                    var func = $.inArray(e.type, ['check', 'check-all']) > -1 ? 'union' : 'difference';
                    selections = window._[func](selections, ids);
                });

            $table.on('search.bs.table',
                function () {
                    selections = [];
                    console.log("selection cleared");
                });

            // Page size persistence - restore saved page size when table loads
            $table.on('load-success.bs.table', function () {
                var savedPageSize = getSavedPageSize();
                if (savedPageSize !== '10') { // Only change if different from default
                    $table.bootstrapTable('refreshOptions', {
                        pageSize: parseInt(savedPageSize)
                    });
                }
            });

            // Listen for page size changes
            $table.on('page-size-change.bs.table', function (e, pageSize) {
                savePageSize(pageSize);
            });
        });

        $("#btnDeleteMessages").click(function () {

            $('#deleteConfirmationModal').modal()
        });

        $('#btnDeleteMessagesModalConfirmation').click(function () {

            $('#deleteConfirmationModal').modal('hide');
            displayBusyIndicator();
            $('#deleteMessagesIdsField').val(selections);
            $('#deleteMessagesForm').submit();
        })

        function releaseSelectedMessages() {
            displayBusyIndicator();
            $('#releaseSelectedMessagesIdsField').val(selections);
            $('#releaseSelectedMessagesQueueNameField').val('@Model.QueueInfo.Name');
            $('#releaseSelectedMessagesForm').submit();
        }

        function replayMessages() {
            displayBusyIndicator();
            $('#replayMessagesIdsField').val(selections);
            $('#replayMessagesQueueNameField').val('@Model.QueueInfo.Name');
            $('#replayMessagesForm').submit();
        }

        function getQueueMessages() {
            displayBusyIndicator();
            var qtyValue = $('#getQty :selected').val();
            $('#receiveMessagesQtyField').val(qtyValue);
            $('#receiveMessagesQueueNameField').val('@Model.QueueInfo.Name');
            $('#receiveMessagesForm').submit();
        }

        function bulkReplayAllMessages() {
            if (confirm('Are you sure you want to replay ALL messages? This will process all messages in your session and may take some time for large volumes.')) {
                displayBusyIndicator();
                $('#bulkReplayAllQueueNameField').val('@Model.QueueInfo.Name');
                
                $.ajax({
                    url: '@Url.Action("BulkReplayAllMessages", "MessageList")',
                    type: 'POST',
                    data: $('#bulkReplayAllForm').serialize(),
                    success: function(response) {
                        if (response.success) {
                            showBulkReplayProgress(response.operationId);
                        } else {
                            alert('Failed to start bulk replay operation');
                            hideBusyIndicator();
                        }
                    },
                    error: function() {
                        alert('Error starting bulk replay operation');
                        hideBusyIndicator();
                    }
                });
            }
        }

        function showBulkReplayProgress(operationId) {
            var progressModal = $('#bulkReplayProgressModal');
            progressModal.modal('show');
            
            var statusInterval = setInterval(function() {
                $.ajax({
                    url: '@Url.Action("GetBulkReplayStatus", "MessageList")',
                    type: 'GET',
                    success: function(status) {
                        updateProgressDisplay(status);
                        
                        if (status.isComplete) {
                            clearInterval(statusInterval);
                            if (status.status === 'Completed') {
                                $('#progressStatus').html('<span class="text-success">✓ Completed successfully!</span>');
                                $('#progressDetails').html('Processed ' + status.totalMessagesProcessed + ' messages in ' + status.totalBatchesProcessed + ' batches.');
                                setTimeout(function() {
                                    progressModal.modal('hide');
                                    location.reload();
                                }, 2000);
                            } else if (status.status === 'Failed') {
                                $('#progressStatus').html('<span class="text-danger">✗ Failed</span>');
                                $('#progressDetails').html('Error: ' + status.errorMessage);
                            }
                        }
                    },
                    error: function() {
                        clearInterval(statusInterval);
                        $('#progressStatus').html('<span class="text-danger">✗ Error checking status</span>');
                    }
                });
            }, 1000);
        }

        function updateProgressDisplay(status) {
            $('#progressStatus').text(status.status);
            if (status.totalMessagesProcessed > 0) {
                $('#progressDetails').html('Processed ' + status.totalMessagesProcessed + ' messages in ' + status.totalBatchesProcessed + ' batches...');
            }
        }

        // Page size persistence functions
        function savePageSize(pageSize) {
            sessionStorage.setItem('messageListPageSize', pageSize);
        }

        function getSavedPageSize() {
            return sessionStorage.getItem('messageListPageSize') || '10'; // Default to 10 if not set
        }

        function applySavedPageSize() {
            var savedPageSize = getSavedPageSize();
            $('#table').bootstrapTable('refreshOptions', {
                pageSize: parseInt(savedPageSize)
            });
        }


    </script>
}

@section Styles
{
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-table/1.18.1/bootstrap-table.min.css" />
}

<div>

    <input id="baseUrl" type="hidden" value="@(Url.Action("Index", "MessageDetails"))" />

    <h3 class="govuk-heading-l">Queue - @Model.QueueInfo.Name</h3>

    <dl class="govuk-summary-list">
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">
                Investigating
            </dt>
            <dd class="govuk-summary-list__value">
                @Model.Count
            </dd>
        </div>
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">
                On the queue
            </dt>
            <dd class="govuk-summary-list__value">
                @Model.QueueInfo.MessageCount
            </dd>
        </div>
    </dl>

    <div>
        <fieldset>
            <legend>Message actions</legend>

            <select class="govuk-select" name="getQty" id="getQty">
                <option value="250">250</option>
                <option value="500">500</option>
                <option value="1000">1000</option>
            </select>
            <a class="govuk-link" id="btnReceiveMessages" href="#" onclick="getQueueMessages()" title="Get any further messages that may be on the queue">Get more</a> |
            <form method="post" id="receiveMessagesForm" asp-action="ReceiveMessagesFromQueue" hidden="hidden">
                <input type="hidden" name="getQuantity" id="receiveMessagesQtyField" />
                <input type="hidden" name="queueName" id="receiveMessagesQueueNameField" />
            </form>

            <a class="govuk-link" id="btnReplayMessages" href="#" onclick="replayMessages()" title="Move selected messages back to the processing queue">Move selected to processing queue</a> |
            <form method="post" id="replayMessagesForm" asp-action="ReplayMessages" hidden="hidden">
                <input type="hidden" name="ids" id="replayMessagesIdsField" />
                <input type="hidden" name="queueName" id="replayMessagesQueueNameField" />
            </form>

            <a class="govuk-link" id="btnBulkReplayAll" href="#" onclick="bulkReplayAllMessages()" title="Move ALL messages back to the processing queue (handles large volumes without timeout)">Move ALL to processing queue</a> |
            <form method="post" id="bulkReplayAllForm" asp-action="BulkReplayAllMessages" hidden="hidden">
                <input type="hidden" name="queueName" id="bulkReplayAllQueueNameField" />
                <input type="hidden" name="batchSize" id="bulkReplayAllBatchSizeField" value="100" />
            </form>

            <a class="govuk-link" id="btnDeleteMessages" href="#" title="Delete the selected messages permanently">Delete selected</a> |
            <form method="post" id="deleteMessagesForm" asp-action="DeleteMessages" hidden="hidden">
                <input type="hidden" name="ids" id="deleteMessagesIdsField" />
            </form>

            <a class="govuk-link" id="btnReleaseSelectedMessages" href="#" onclick="releaseSelectedMessages()" title="Release selected messages back to the ServiceBus Queue they came from">Release selected</a> |
            <form method="post" id="releaseSelectedMessagesForm" asp-action="ReleaseSelectedMessages" hidden="hidden">
                <input type="hidden" name="ids" id="releaseSelectedMessagesIdsField" />
                <input type="hidden" name="queueName" id="releaseSelectedMessagesQueueNameField" />
            </form>

            <a class="govuk-link" asp-controller="MessageList" asp-action="ReleaseAllMessages" asp-route-queue="@Model.QueueInfo.Name" onclick="displayBusyIndicator()" title="Release messages back to the servicebus queue they came from">Release all</a>
        </fieldset>
    </div>

    <table id="table"
           class="govuk-table"
           data-toggle="table"
           data-pagination="true"
           data-search="true"
           data-click-to-select="true"
           data-sortable="true"
           data-side-pagination="server"
           data-url="@Url.Action("Index", "Messages")"
           data-page-size="10"
           data-page-list="[10, 25, 50, 100, 250, 500, 1000]"
           data-page-size-select="true"
           style="table-layout: fixed"
           data-response-handler="responseHandler">
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                <th scope="col"
                    class="col-wrap"
                    data-field="id"
                    data-visible="false">
                </th>
                <th scope="col"
                    class="col-wrap"
                    data-field="state"
                    data-checkbox="true"
                    data-width="5"
                    data-width-unit="%">
                </th>
                <th scope="col"
                    class="col-wrap"
                    data-sortable="true"
                    data-field="originatingEndpoint"
                    data-width="10"
                    data-width-unit="%">
                    Originating endpoint
                </th>
                <th scope="col"
                    class="col-wrap"
                    data-sortable="true"
                    data-field="processingEndpoint"
                    data-width="10"
                    data-width-unit="%">
                    Processing endpoint
                </th>
                <th scope="col"
                    class="col-wrap"
                    data-sortable="false"
                    data-field="body"
                    data-width="25"
                    data-width-unit="%">
                    Body
                </th>
                <th scope="col"
                    class="col-wrap"
                    data-sortable="false"
                    data-field="exception"
                    data-width="25"
                    data-width-unit="%">
                    Exception
                </th>
                <th scope="col"
                    class="col-wrap"
                    data-sortable="true"
                    data-field="exceptionType"
                    data-width="10"
                    data-width-unit="%">
                    Exception type
                </th>
                <th scope="col"
                    class="col-wrap"
                    data-sortable="false"
                    data-width="10"
                    data-width-unit="%"
                    data-formatter="operateFormatter">
                    Actions
                </th>
            </tr>
        </thead>
    </table>

    <div class="modal fade" id="deleteConfirmationModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title govuk-heading-m">Delete messages</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <p class="govuk-body">Deleting a message will permanently remove it from a queue. This action is not reversible.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="govuk-button" data-module="govuk-button" id="btnDeleteMessagesModalConfirmation">Confirm</button>
                    <button type="button" class="govuk-button govuk-button--secondary" data-dismiss="modal">Cancel</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="bulkReplayProgressModal" tabindex="-1" role="dialog" aria-labelledby="bulkReplayProgressLabel" aria-hidden="true" data-backdrop="static" data-keyboard="false">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title govuk-heading-m">Bulk Replay Progress</h5>
                </div>
                <div class="modal-body">
                    <div class="govuk-body">
                        <p>Processing all messages in the background...</p>
                        <div class="progress">
                            <div class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" style="width: 100%"></div>
                        </div>
                        <p><strong>Status:</strong> <span id="progressStatus">Running</span></p>
                        <p id="progressDetails">Starting bulk replay operation...</p>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="govuk-button govuk-button--secondary" data-dismiss="modal" id="btnCloseProgress" style="display: none;">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>
